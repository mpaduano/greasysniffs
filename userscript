    // =========================================================================
    // 10. GOOGLE DRIVE SYNC
    // =========================================================================
    const GOOGLE_CLIENT_ID = 'YOUR_CLIENT_ID.apps.googleusercontent.com'; // ← your real client ID
    const DRIVE_FILE_NAME = 'sniffies_soft_filter_backup.json';

    const getAuthHeaders = () => ({
        'Authorization': 'Bearer ' + driveToken,
        'Content-Type': 'application/json'
    });

    const getLoginUrl = () => {
        const redirectUri = 'https://sniffies.com';
        const scope = 'https://www.googleapis.com/auth/drive.appdata';
        return 'https://accounts.google.com/o/oauth2/v2/auth?client_id=' + GOOGLE_CLIENT_ID +
            '&redirect_uri=' + encodeURIComponent(redirectUri) +
            '&response_type=token&scope=' + encodeURIComponent(scope);
    };

    function setSyncStatus(text) {
        const el = document.getElementById('snp-sync-status');
        if (el) el.textContent = text;
    }

    async function getOrCreateDriveFile() {
        if (!driveToken) return null;
        try {
            const searchRes = await fetch('https://www.googleapis.com/drive/v3/files?spaces=appDataFolder&q=name=\'' + DRIVE_FILE_NAME + '\'', { headers: getAuthHeaders() });
            const searchData = await searchRes.json();
            if (searchData.files && searchData.files.length > 0) return searchData.files[0].id;
            const createRes = await fetch('https://www.googleapis.com/drive/v3/files', {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({ name: DRIVE_FILE_NAME, parents: ['appDataFolder'] })
            });
            const createData = await createRes.json();
            return createData.id;
        } catch (err) {
            console.error('[GreaseSniff] Drive API error:', err);
            return null;
        }
    }

    async function syncToDrive() {
        if (!driveToken) { setSyncStatus('Paste a token first ❌'); return; }
        setSyncStatus('Syncing up... ⏳');
        const fileId = await getOrCreateDriveFile();
        if (!fileId) { setSyncStatus('Error: Not authenticated ❌'); return; }
        const payload = {
            appState, profileNotes, bookmarkedProfiles, hiddenProfiles,
            chatHistory: Object.fromEntries(chatHistory),
            savedAt: Date.now()
        };
        try {
            const res = await fetch('https://www.googleapis.com/upload/drive/v3/files/' + fileId + '?uploadType=media', {
                method: 'PATCH',
                headers: getAuthHeaders(),
                body: JSON.stringify(payload)
            });
            setSyncStatus(res.ok ? 'Backed up successfully! ✅' : 'Upload failed (' + res.status + ') ❌');
        } catch (err) {
            setSyncStatus('Upload failed ❌');
        }
    }

    async function syncFromDrive() {
        if (!driveToken) { setSyncStatus('Paste a token first ❌'); return; }
        setSyncStatus('Downloading... ⏳');
        const fileId = await getOrCreateDriveFile();
        if (!fileId) { setSyncStatus('Error: Not authenticated ❌'); return; }
        try {
            const res = await fetch('https://www.googleapis.com/drive/v3/files/' + fileId + '?alt=media', { headers: getAuthHeaders() });
            if (res.status === 200) {
                const data = await res.json();
                appState = { ...appState, ...(data.appState || {}) };
                profileNotes = { ...profileNotes, ...(data.profileNotes || {}) };
                bookmarkedProfiles = { ...bookmarkedProfiles, ...(data.bookmarkedProfiles || {}) };
                hiddenProfiles = { ...hiddenProfiles, ...(data.hiddenProfiles || {}) };
                if (data.chatHistory) {
                    Object.entries(data.chatHistory).forEach(([id, t]) => {
                        const time = Number(t) || 0;
                        if (time > (chatHistory.get(String(id)) || 0)) chatHistory.set(String(id), time);
                    });
                    chatDirty = true;
                }
                saveState(); saveNotes(); saveBookmarks(); saveHidden();
                syncControlsFromState();
                renderCRM();
                scheduleFilter();
                setSyncStatus('Restored successfully! ✅');
            } else if (res.status === 401) {
                setSyncStatus('Token expired — get a new one ❌');
            } else {
                setSyncStatus('Restore failed (' + res.status + ') ❌');
            }
        } catch (err) {
            setSyncStatus('Download failed ❌');
        }
    }

    function bindSyncControls() {
        const tokenInput = document.getElementById('snp-drive-token-input');
        if (tokenInput) {
            tokenInput.value = driveToken || '';
            tokenInput.onchange = (e) => {
                driveToken = e.target.value.trim();
                GM_setValue(KEY_TOKEN, driveToken);
                setSyncStatus('Token saved.');
            };
        }
        const authBtn = document.getElementById('snp-auth-btn');
        if (authBtn) authBtn.onclick = () => {
            window.open(getLoginUrl(), '_blank', 'width=500,height=600');
            setSyncStatus('Log in, copy the token from the popup URL bar, paste it above.');
        };
        const up = document.getElementById('snp-sync-up');
        if (up) up.onclick = syncToDrive;
        const down = document.getElementById('snp-sync-down');
        if (down) down.onclick = syncFromDrive;
    }

    // =========================================================================
    // 11. BOOTSTRAP — every step isolated so one failure can't kill the rest
    // =========================================================================
    const initErrors = [];
    function safe(fn, label) {
        try { fn(); }
        catch (err) {
            initErrors.push(label + ': ' + ((err && err.message) || err));
            console.error('[GreaseSniff] init step failed —', label, err);
        }
    }

    function startFilterObserver() {
        new MutationObserver(scheduleFilter).observe(document.body, { childList: true, subtree: true });
    }

    function persistChats() {
        if (chatDirty) {
            chatDirty = false;
            GM_setValue(KEY_CHATS, Object.fromEntries(chatHistory));
        }
    }

    function init() {
        console.log('[GreaseSniff] init starting (DOM ready).');
        safe(injectStyles, 'styles');
        safe(injectDashboard, 'dashboard');
        safe(observeProfileModals, 'profile-modal observer');
        safe(startFilterObserver, 'filter observer');
        safe(() => {
            setInterval(() => {
                try { applyFilters(); maintainUI(); updateLiveStats(); }
                catch (err) { console.error('[GreaseSniff] tick error:', err); }
            }, 2000);
        }, 'main interval');
        safe(() => {
            setInterval(() => {
                try { trimMap(profileCache, 5000); trimMap(chatHistory, 5000); persistChats(); }
                catch (err) { console.error('[GreaseSniff] persistence error:', err); }
            }, 30000);
        }, 'persistence interval');
        window.addEventListener('pagehide', persistChats);

        if (initErrors.length) {
            showFatalBanner('GreaseSniff init problems: ' + initErrors.join(' | '));
        }
        console.log('[GreaseSniff] v2.4 loaded. Profiles: ' + profileCache.size + ', chats: ' + chatHistory.size);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
        init();
    }

    // OAuth token capture
    if (window.location.hash.includes('access_token=')) {
        try {
            const params = new URLSearchParams(window.location.hash.substring(1));
            const token = params.get('access_token');
            if (token) {
                driveToken = token;
                GM_setValue(KEY_TOKEN, token);
                history.replaceState(null, '', window.location.pathname + window.location.search);
                alert('GreaseSniff: Google Drive token captured! You can close the popup tab.');
            }
        } catch (err) {
            console.error('[GreaseSniff] token capture failed:', err);
        }
    }

})();
