// ==UserScript==
// @name         GreaseSniff
// @namespace    https://sniffies.com/
// @version      2.1.0
// @description  Advanced filtering, CRM, chat-badges, and quick phrases for Sniffies.
// @match        https://sniffies.com/*
// @match        https://*.sniffies.com/*
// @run-at       document-start
// @noframes
// @grant        unsafeWindow
// @grant        GM_getValue
// @grant        GM_setValue
// ==/UserScript==

(function () {
    'use strict';

    // =========================================================================
    // 0. PAGE-WINDOW ACCESS & DEBUG
    // Tampermonkey sandboxes `window` when grants are present — patching it
    // does NOT affect the page. We must patch `unsafeWindow` so our hooks see
    // the site's real network traffic.
    // =========================================================================
    const pageWindow = (typeof unsafeWindow !== 'undefined') ? unsafeWindow : window;
    const DEBUG = false; // set to true to log intercepted URLs + cache fills

    // =========================================================================
    // 1. STATE & CONFIGURATION
    // =========================================================================

    const STATE_KEY     = "sniffiesSoftFilterState_v2";
    const NOTES_KEY     = "sniffiesSoftFilterNotes_v1";
    const BOOKMARKS_KEY = "sniffiesSoftFilterBookmarks_v1";
    const HIDDEN_KEY    = "sniffiesHiddenProfiles_v1";
    const CHAT_KEY      = "sniffiesChatHistory_v1";
    const TOKEN_KEY     = "snp_drive_token";

    const DEFAULT_STATE = {
        enabled: true,
        // Attitude Filters
        hideBottom: true, hideVersBottom: true, hideSide: false,
        hideVers: false, hideVersTop: false, hideTop: false,
        hideUnspecified: false,
        // Text Filters
        excludeProfileTerms: "", includeProfileTerms: "",
        excludeProfileTermsEnabled: true, includeProfileTermsEnabled: true,
        // Chat Filters
        hideRecentChats24h: false, hideAnyChats: false, showOnlyChats: false,
        showChatAges: true,
        // Quick Phrases
        introMessages: ["Howdy", "Hey there", "How's your night going?", "What's up?", "Want to chat?"].join("\n")
    };

    let appState = { ...DEFAULT_STATE, ...(GM_getValue(STATE_KEY, {}) || {}) };
    const saveState = () => GM_setValue(STATE_KEY, appState);

    let profileNotes       = GM_getValue(NOTES_KEY, {}) || {};
    let bookmarkedProfiles = GM_getValue(BOOKMARKS_KEY, {}) || {};
    let hiddenProfiles     = GM_getValue(HIDDEN_KEY, {}) || {};
    const saveNotes         = () => GM_setValue(NOTES_KEY, profileNotes);
    const saveBookmarks     = () => GM_setValue(BOOKMARKS_KEY, bookmarkedProfiles);
    const saveHiddenProfiles = () => GM_setValue(HIDDEN_KEY, hiddenProfiles);

    // =========================================================================
    // 2. CACHES
    // =========================================================================

    const profileCache = new Map(); // profileId -> {id, name, role, description}
    // Persisted so "Hide Chatted (Ever)" survives reloads
    const chatHistoryCache = new Map(Object.entries(GM_getValue(CHAT_KEY, {}) || {}));
    let chatCacheDirty = false;

    // Evict OLDEST entries instead of wiping everything (filtering keeps working)
    const trimMap = (map, max) => {
        while (map.size > max) map.delete(map.keys().next().value);
    };

    // =========================================================================
    // 3. FILTER SCHEDULING (rAF-throttled)
    // =========================================================================

    let filterScheduled = false;
    function scheduleFilter() {
        if (filterScheduled) return;
        filterScheduled = true;
        requestAnimationFrame(() => {
            filterScheduled = false;
            applyFilters();
        });
    }

    // =========================================================================
    // 4. NETWORK INTERCEPTORS  (top-level on purpose: must patch BEFORE the
    //    page's own code runs, since we execute at document-start)
    // =========================================================================

    const originalFetch = pageWindow.fetch;
    pageWindow.fetch = async function (...args) {
        const response = await originalFetch.apply(pageWindow, args);
        try {
            const resource = args[0];
            const url = typeof resource === 'string' ? resource
                : (resource && typeof resource.url === 'string') ? resource.url
                : (resource && typeof resource.href === 'string') ? resource.href
                : '';
            if (DEBUG) console.log('[GreaseSniff] fetch:', url);

            if (url && (url.includes('/api/v1/users/partial') || url.includes('/api/v1/users/search'))) {
                const clone = response.clone();
                clone.json().then((data) => {
                    const users = Array.isArray(data) ? data : (data?.users || data?.data || []);
                    if (!Array.isArray(users)) return;
                    users.forEach((user) => {
                        if (user && user.id) {
                            profileCache.set(user.id, {
                                id: user.id,
                                name: user.name || "",
                                role: String(user.role ?? user.attitude ?? "").trim().toLowerCase(),
                                description: String(user.description ?? user.about ?? "").toLowerCase()
                            });
                        }
                    });
                    if (DEBUG) console.log('[GreaseSniff] profile cache size:', profileCache.size);
                    scheduleFilter();
                }).catch((err) => console.warn('[GreaseSniff] response JSON parse failed:', err));
            }
        } catch (err) {
            console.error('[GreaseSniff] fetch interceptor error:', err);
        }
        return response;
    };

    const OriginalWebSocket = pageWindow.WebSocket;
    function PatchedWebSocket(url, protocols) {
        const ws = new OriginalWebSocket(url, protocols);
        ws.addEventListener('message', (event) => {
            try {
                if (typeof event.data !== 'string') return;
                const payload = JSON.parse(event.data);
                const senderId = payload?.data?.senderId;
                if (payload?.type === 'chat_message' && senderId) {
                    // NOTE: your own outgoing messages may carry YOUR senderId.
                    // If your own marker starts getting hidden by chat filters,
                    // compare senderId against your own user id here and skip.
                    chatHistoryCache.set(senderId, Date.now());
                    chatCacheDirty = true;
                    scheduleFilter();
                }
            } catch (e) { /* not JSON / not relevant */ }
        });
        return ws;
    }
    PatchedWebSocket.prototype = OriginalWebSocket.prototype;
    ['CONNECTING', 'OPEN', 'CLOSING', 'CLOSED'].forEach((k) => {
        try { PatchedWebSocket[k] = OriginalWebSocket[k]; } catch (e) { /* ignore */ }
    });
    pageWindow.WebSocket = PatchedWebSocket;

    // =========================================================================
    // 5. CORE FILTER ENGINE
    // =========================================================================

    const checkTextMatch = (profileText, termsString) => {
        if (!termsString || !profileText) return false;
        const terms = termsString.split('\n').map(t => t.trim().toLowerCase()).filter(t => t.length > 0);
        return terms.some(term => profileText.includes(term));
    };

    function applyFilters() {
        const markers = document.querySelectorAll('[data-testid="markerUserContainer"], .chat-list-item');
        const now = Date.now();
        const oneDayMs = 24 * 60 * 60 * 1000;

        if (!appState.enabled) {
            markers.forEach((marker) => {
                marker.classList.remove('sniffies-soft-hide');
                marker.style.boxShadow = '';
                const badge = marker.querySelector('.sniffies-chat-age-badge');
                if (badge) badge.remove();
            });
            return;
        }

        markers.forEach((marker) => {
            const profileId = marker.id || marker.dataset?.userId;
            if (!profileId) return;

            const profile = profileCache.get(profileId);
            const role = profile ? String(profile.role ?? '').trim().toLowerCase() : '';
            const description = profile ? (profile.description || '') : '';

            // "vers" matches both "vers ..." and "versatile ..." API strings
            const isVers = role.includes('vers');
            const isBottom = role.includes('bottom');
            const isTop = role.includes('top');

            let shouldHide = !!hiddenProfiles[profileId];
            let shouldHighlight = false;

            if (!shouldHide && profile) {
                if (appState.hideBottom && isBottom && !isVers) shouldHide = true;
                if (appState.hideVersBottom && isBottom && isVers) shouldHide = true;
                if (appState.hideSide && role === 'side') shouldHide = true;
                if (appState.hideTop && isTop && !isVers) shouldHide = true;
                if (appState.hideVersTop && isTop && isVers) shouldHide = true;
                if (appState.hideVers && isVers && !isBottom && !isTop) shouldHide = true;
                if (appState.hideUnspecified && (role === '' || role === 'unspecified' || role === 'n/a')) shouldHide = true;

                if (!shouldHide && appState.excludeProfileTermsEnabled && description &&
                    checkTextMatch(description, appState.excludeProfileTerms)) shouldHide = true;

                if (!shouldHide && appState.includeProfileTermsEnabled && description &&
                    checkTextMatch(description, appState.includeProfileTerms)) shouldHighlight = true;
            }

            const lastChatTime = chatHistoryCache.get(profileId);
            if (!shouldHide && lastChatTime) {
                if (appState.hideAnyChats || (appState.hideRecentChats24h && (now - lastChatTime) < oneDayMs)) shouldHide = true;
            }
            if (!shouldHide && appState.showOnlyChats && !lastChatTime) shouldHide = true;

            if (shouldHide) {
                marker.classList.add('sniffies-soft-hide');
                marker.style.boxShadow = '';
                const badge = marker.querySelector('.sniffies-chat-age-badge');
                if (badge) badge.remove();
                return;
            }

            marker.classList.remove('sniffies-soft-hide');

            if (shouldHighlight) {
                marker.style.boxShadow = '0 0 0 3px rgba(255, 214, 10, 0.9)';
                marker.style.borderRadius = '9999px';
            } else {
                marker.style.boxShadow = '';
                marker.style.borderRadius = '';
            }

            if (appState.showChatAges && lastChatTime) {
                let badge = marker.querySelector('.sniffies-chat-age-badge');
                if (!badge) {
                    badge = document.createElement('div');
                    badge.className = 'sniffies-chat-age-badge';
                    badge.style.cssText = 'position:absolute; top:-10px; right:-10px; background:rgba(9,16,28,0.9); color:#78d6ff; padding:2px 5px; border-radius:10px; font-size:10px; pointer-events:none; z-index:100;';
                    marker.appendChild(badge);
                }
                const hoursAgo = Math.floor((now - lastChatTime) / (1000 * 60 * 60));
                badge.textContent = hoursAgo < 1 ? '<1h' : `${hoursAgo}h`;
            } else {
                const badge = marker.querySelector('.sniffies-chat-age-badge');
                if (badge) badge.remove();
            }
        });
    }

    // =========================================================================
    // 6. RIGHT-CLICK CONTEXT MENU (top-level listeners are safe on `document`)
    // =========================================================================

    let currentContextMenu = null;

    const closeContextMenu = () => {
        currentContextMenu?.remove();
        currentContextMenu = null;
    };

    const showContextMenu = (x, y, profileId) => {
        closeContextMenu();

        const menu = document.createElement('div');
        menu.id = 'snp-context-menu';
        menu.style.left = `${Math.min(x, window.innerWidth - 170)}px`;
        menu.style.top = `${Math.min(y, window.innerHeight - 100)}px`;

        const phraseBtn = document.createElement('button');
        phraseBtn.className = 'snp-context-btn';
        phraseBtn.textContent = '💬 Send Quick Phrase';
        phraseBtn.onclick = () => showQuickPhraseMenu(x, y, profileId);

        const isHidden = !!hiddenProfiles[profileId];
        const hideBtn = document.createElement('button');
        hideBtn.className = 'snp-context-btn danger';
        hideBtn.textContent = isHidden ? '👁 Unhide Profile' : '🚫 Hide Profile';
        hideBtn.onclick = () => {
            if (isHidden) delete hiddenProfiles[profileId];
            else hiddenProfiles[profileId] = { added: Date.now() };
            saveHiddenProfiles();
            scheduleFilter();
            closeContextMenu();
        };

        menu.append(phraseBtn, hideBtn);
        document.body.appendChild(menu);
        currentContextMenu = menu;
    };

    document.addEventListener('contextmenu', (e) => {
        const marker = e.target.closest('[data-testid="markerUserContainer"]');
        const chatRow = e.target.closest('.chat-list-item');
        if (!marker && !chatRow) return;

        const profileId = marker ? marker.id : chatRow.dataset.userId;
        if (!profileId) return;

        e.preventDefault();
        showContextMenu(e.clientX, e.clientY, profileId);
    });

    document.addEventListener('click', (e) => {
        if (currentContextMenu && !currentContextMenu.contains(e.target)) closeContextMenu();
        if (currentPhraseMenu && !currentPhraseMenu.contains(e.target)) closePhraseMenu();
    });
    window.addEventListener('scroll', closeContextMenu, { passive: true });

    // =========================================================================
    // 7. QUICK PHRASES FLOATING MENU
    // =========================================================================

    let currentPhraseMenu = null;

    const closePhraseMenu = () => {
        currentPhraseMenu?.remove();
        currentPhraseMenu = null;
    };

    const sendChatMessage = (phrase) => {
        const chatInput = document.querySelector('textarea[placeholder*="message" i], input[placeholder*="message" i]');
        if (!chatInput) {
            console.warn('[GreaseSniff] Chat input not found.');
            return;
        }

        // Use the setter matching the element type — the textarea setter on an
        // <input> throws "Illegal invocation".
        const proto = (chatInput.tagName === 'TEXTAREA')
            ? window.HTMLTextAreaElement.prototype
            : window.HTMLInputElement.prototype;
        const valueSetter = Object.getOwnPropertyDescriptor(proto, 'value')?.set;
        if (valueSetter) {
            valueSetter.call(chatInput, phrase);
            chatInput.dispatchEvent(new Event('input', { bubbles: true }));
        }

        const sendBtn = document.querySelector('button[aria-label="Send"], button[title="Send"]');
        if (sendBtn) {
            setTimeout(() => sendBtn.click(), 250); // let React sync state first
        } else {
            chatInput.dispatchEvent(new KeyboardEvent('keydown', {
                key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true
            }));
        }
    };

    const showQuickPhraseMenu = (x, y, profileId) => {
        closePhraseMenu();
        closeContextMenu();

        const menu = document.createElement('div');
        menu.id = 'snp-phrase-menu';
        menu.style.cssText = `
            position: fixed; z-index: 1000001;
            background: rgba(12, 18, 30, 0.98);
            border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.6); padding: 8px;
            display: flex; flex-direction: column; gap: 6px; min-width: 200px;
            left: ${Math.min(x, window.innerWidth - 220)}px;
            top: ${Math.min(y, window.innerHeight - 300)}px;
        `;

        const title = document.createElement('div');
        title.textContent = '💬 Quick Phrases';
        title.style.cssText = 'font-size: 11px; color: #8ea0ba; margin-bottom: 4px; font-weight: bold;';
        menu.appendChild(title);

        // NOTE: sends to whatever conversation is currently OPEN, not the
        // right-clicked person (site limitation unless we open that chat first).
        const phrases = appState.introMessages.split('\n').map(p => p.trim()).filter(p => p.length > 0);
        phrases.forEach((phrase) => {
            const btn = document.createElement('button');
            btn.className = 'snp-context-btn';
            btn.textContent = phrase;
            btn.onclick = () => {
                sendChatMessage(phrase);
                closePhraseMenu();
            };
            menu.appendChild(btn);
        });

        document.body.appendChild(menu);
        currentPhraseMenu = menu;
    };

    // =========================================================================
    // 8. PROFILE VIEW CRM (bookmarks + notes) — injected via init(), not here
    // =========================================================================

    const observeProfileModals = () => {
        const observer = new MutationObserver(() => {
            const profileModal = document.querySelector('[data-testid="profileModal"], .profile-modal-container');
            if (profileModal && !document.getElementById('snp-crm-container')) {
                injectProfileCRM(profileModal);
            }
        });
        observer.observe(document.body, { childList: true, subtree: true });
    };

    const injectProfileCRM = (modalNode) => {
        if (document.getElementById('snp-crm-container')) return;
        const match = window.location.pathname.match(/\/profile\/([a-zA-Z0-9_-]+)/);
        if (!match) return;
        const profileId = match[1];

        const crmContainer = document.createElement('div');
        crmContainer.id = 'snp-crm-container';
        crmContainer.style.cssText = `
            background: rgba(100, 150, 255, 0.1); border-left: 3px solid rgba(100, 150, 255, 0.6);
            padding: 10px; margin: 12px 16px; border-radius: 6px;
            display: flex; flex-direction: column; gap: 8px;
        `;

        const isBookmarked = !!bookmarkedProfiles[profileId];
        const bookmarkBtn = document.createElement('button');
        const setBookmarkUI = (on) => {
            bookmarkBtn.textContent = on ? '⭐ Bookmarked' : '☆ Bookmark Profile';
            bookmarkBtn.style.background = on ? 'rgba(255,210,80,0.3)' : 'rgba(255,255,255,0.1)';
            bookmarkBtn.style.color = on ? '#ffd250' : '#fff';
        };
        setBookmarkUI(isBookmarked);
        bookmarkBtn.style.cssText += 'align-self: flex-start; padding: 4px 10px; border-radius: 4px; border: none; cursor: pointer; font-weight: bold;';

        bookmarkBtn.onclick = () => {
            const nowOn = !bookmarkedProfiles[profileId];
            if (nowOn) bookmarkedProfiles[profileId] = { added: Date.now() };
            else delete bookmarkedProfiles[profileId];
            setBookmarkUI(nowOn);
            saveBookmarks();
            renderCRMList();
        };

        const notesArea = document.createElement('textarea');
        notesArea.placeholder = 'Add private notes here...';
        notesArea.value = profileNotes[profileId] || '';
        notesArea.style.cssText = `
            width: 100%; min-height: 60px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2);
            color: #fff; padding: 6px; border-radius: 4px; font-family: inherit; resize: vertical;
        `;
        notesArea.addEventListener('input', (e) => {
            const text = e.target.value.trim();
            if (text) profileNotes[profileId] = text;
            else delete profileNotes[profileId];
            saveNotes();
        });

        crmContainer.appendChild(bookmarkBtn);
        crmContainer.appendChild(notesArea);

        const profileContentInfo = modalNode.querySelector('.profile-info, [data-testid="profileContent"]');
        if (profileContentInfo) profileContentInfo.prepend(crmContainer);
        else modalNode.prepend(crmContainer);
    };

    // =========================================================================
    // 9. MAIN SETTINGS DASHBOARD UI
    // =========================================================================

    const BINDINGS = [
        ['enabled', 'checkbox'],
        ['hideBottom', 'checkbox'], ['hideVersBottom', 'checkbox'], ['hideSide', 'checkbox'],
        ['hideVers', 'checkbox'], ['hideVersTop', 'checkbox'], ['hideTop', 'checkbox'],
        ['hideUnspecified', 'checkbox'],
        ['showChatAges', 'checkbox'], ['hideRecentChats24h', 'checkbox'],
        ['hideAnyChats', 'checkbox'], ['showOnlyChats', 'checkbox'],
        ['excludeProfileTermsEnabled', 'checkbox'], ['includeProfileTermsEnabled', 'checkbox'],
        ['excludeProfileTerms', 'text'], ['includeProfileTerms', 'text'],
        ['introMessages', 'text']
    ];

    const switchTab = (targetId) => {
        const dash = document.getElementById('snp-main-dashboard');
        if (!dash) return;
        dash.querySelectorAll('.snp-tab').forEach(t => t.classList.toggle('active', t.dataset.target === targetId));
        dash.querySelectorAll('.snp-tab-content').forEach(c => { c.style.display = (c.id === targetId) ? 'block' : 'none'; });
    };

    const bindControls = () => {
        BINDINGS.forEach(([key, type]) => {
            const el = document.getElementById(`snp-opt-${key}`);
            if (!el) return;
            if (type === 'checkbox') {
                el.checked = !!appState[key];
                el.onchange = (e) => { appState[key] = e.target.checked; saveState(); scheduleFilter(); };
            } else {
                el.value = appState[key] ?? '';
                el.addEventListener('input', (e) => { appState[key] = e.target.value; saveState(); });
            }
        });
    };

    // Re-syncs every control from appState (used after Drive restore)
    const syncControlsFromState = () => {
        BINDINGS.forEach(([key, type]) => {
            const el = document.getElementById(`snp-opt-${key}`);
            if (!el) return;
            if (type === 'checkbox') el.checked = !!appState[key];
            else el.value = appState[key] ?? '';
        });
    };

    const renderCRMList = () => {
        const list = document.getElementById('snp-crm-list');
        if (!list) return;
        list.textContent = '';

        const allSavedIds = new Set([...Object.keys(bookmarkedProfiles), ...Object.keys(profileNotes)]);
        if (allSavedIds.size === 0) {
            const empty = document.createElement('div');
            empty.style.cssText = 'color:#8ea0ba; text-align:center; padding:10px;';
            empty.textContent = 'No bookmarks or notes yet.';
            list.appendChild(empty);
        } else {
            allSavedIds.forEach((id) => {
                const item = document.createElement('div');
                item.className = 'snp-crm-item';

                const row = document.createElement('div');
                row.style.cssText = 'display:flex; justify-content:space-between; margin-bottom:4px;';

                const link = document.createElement('a');
                link.href = `/profile/${id}`;
                link.target = '_blank';
                link.textContent = `Profile: ${String(id).substring(0, 8)}…`;

                const icon = document.createElement('span');
                icon.textContent = bookmarkedProfiles[id] ? '⭐' : '📝';

                row.append(link, icon);
                item.appendChild(row);

                const note = profileNotes[id] || '';
                if (note) {
                    const noteDiv = document.createElement('div');
                    noteDiv.style.cssText = 'color:#a9b8cc; font-style:italic;';
                    noteDiv.textContent = `"${note}"`; // textContent: safe for any characters
                    item.appendChild(noteDiv);
                }
                list.appendChild(item);
            });
        }

        const hiddenList = document.getElementById('snp-hidden-list');
        if (hiddenList) {
            hiddenList.textContent = '';
            const ids = Object.keys(hiddenProfiles);
            const header = document.createElement('div');
            header.style.cssText = 'color:#8ea0ba; font-weight:bold;';
            header.textContent = `Hidden profiles (${ids.length})`;
            hiddenList.appendChild(header);

            ids.forEach((id) => {
                const row = document.createElement('div');
                row.style.cssText = 'display:flex; justify-content:space-between; align-items:center; gap:6px;';
                const label = document.createElement('span');
                label.textContent = `${String(id).substring(0, 8)}…`;
                const btn = document.createElement('button');
                btn.textContent = '👁 Unhide';
                btn.style.cssText = 'background:rgba(255,255,255,0.1); color:#fff; border:none; padding:2px 8px; border-radius:4px; cursor:pointer; font-size:11px;';
                btn.onclick = () => {
                    delete hiddenProfiles[id];
                    saveHiddenProfiles();
                    renderCRMList();
                    scheduleFilter();
                };
                row.append(label, btn);
                hiddenList.appendChild(row);
            });
        }
    };

    const injectStyles = () => {
        if (document.getElementById('snp-global-style')) return;
        const style = document.createElement('style');
        style.id = 'snp-global-style';
        style.textContent = `
            #snp-context-menu {
                position: fixed;
                z-index: 1000000;
                background: rgba(15, 20, 30, 0.95);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 8px;
                box-shadow: 0 8px 24px rgba(0,0,0,0.5);
                padding: 6px;
                display: flex;
                flex-direction: column;
                gap: 4px;
                min-width: 160px;
                font: 13px system-ui, sans-serif;
            }
            .snp-context-btn {
                background: transparent;
                border: none;
                color: #eef4ff;
                text-align: left;
                padding: 8px 12px;
                border-radius: 4px;
                cursor: pointer;
                transition: background 0.15s ease;
            }
            .snp-context-btn:hover { background: rgba(255, 255, 255, 0.1); }
            .snp-context-btn.danger:hover { background: rgba(255, 85, 85, 0.2); color: #ff7575; }
            .sniffies-soft-hide { display: none !important; }
        `;
        document.head.appendChild(style);
    };

    const injectDashboardUI = () => {
        // Self-cleaning: remove stale UI before rebuilding (watchdog safety)
        document.getElementById('snp-dashboard-launcher')?.remove();
        document.getElementById('snp-main-dashboard')?.remove();

        if (!document.getElementById('snp-dashboard-style')) {
            const style = document.createElement('style');
            style.id = 'snp-dashboard-style';
            style.textContent = `
                .snp-tab { flex: 1; background: transparent; border: none; border-bottom: 2px solid transparent; color: #8ea0ba; padding: 10px; cursor: pointer; font-weight: bold; }
                .snp-tab.active { color: #67d1ff; border-bottom-color: #67d1ff; background: rgba(255,255,255,0.05); }
                .snp-tab:hover:not(.active) { color: #fff; background: rgba(255,255,255,0.02); }
                .snp-crm-item { background: rgba(255,255,255,0.05); padding: 8px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1); }
                .snp-crm-item a { color: #67d1ff; text-decoration: none; font-weight: bold; }
                .snp-crm-item a:hover { text-decoration: underline; }
            `;
            document.head.appendChild(style);
        }

        const launcher = document.createElement('button');
        launcher.id = 'snp-dashboard-launcher';
        launcher.textContent = '⚙️ Sniffies Filter';
        launcher.style.cssText = `
            position: fixed; bottom: 20px; left: 20px; z-index: 999999;
