    // 11. GOOGLE DRIVE SYNC ENGINE
    // =========================================================================
    // Note: You will need to bring over your Google Cloud Client ID from the original script
    const GOOGLE_CLIENT_ID = 'YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com';
    const FILE_NAME = 'sniffies_soft_filter_backup.json';
    
    let driveAccessToken = GM_getValue('snp_drive_token', null);
    const getAuthHeaders = () => ({
        'Authorization': `Bearer ${driveAccessToken}`,
        'Content-Type': 'application/json'
    });
    // Generate OAuth Login URL
    const getLoginUrl = () => {
        const redirectUri = 'https://sniffies.com'; // Or a custom local landing page
        const scope = 'https://www.googleapis.com/auth/drive.appdata';
        return `https://accounts.google.com/o/oauth2/v2/auth?client_id=${GOOGLE_CLIENT_ID}&redirect_uri=${redirectUri}&response_type=token&scope=${scope}`;
    };
    // 1. Find or Create Backup File
    const getOrCreateDriveFile = async () => {
        if (!driveAccessToken) return null;
        try {
            // Search for existing file
            const searchRes = await fetch(`https://www.googleapis.com/drive/v3/files?spaces=appDataFolder&q=name='${FILE_NAME}'`, { headers: getAuthHeaders() });
            const searchData = await searchRes.json();
            if (searchData.files && searchData.files.length > 0) {
                return searchData.files[0].id;
            }
            // Create new file if it doesn't exist
            const createRes = await fetch('https://www.googleapis.com/drive/v3/files', {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({ name: FILE_NAME, parents: ['appDataFolder'] })
            });
            const createData = await createRes.json();
            return createData.id;
        } catch (err) {
            console.error("[SniffiesFilter] Drive API Error:", err);
            return null;
        }
    };
    // 2. Upload Data (Sync Up)
    const syncToDrive = async () => {
        document.getElementById('snp-sync-status').textContent = 'Syncing up... ⏳';
        const fileId = await getOrCreateDriveFile();
        if (!fileId) {
            document.getElementById('snp-sync-status').textContent = 'Error: Not authenticated ❌';
            return;
        }
        const payload = {
            appState,
            profileNotes,
            bookmarkedProfiles,
            timestamp: Date.now()
        };
        try {
            await fetch(`https://www.googleapis.com/upload/drive/v3/files/${fileId}?uploadType=media`, {
                method: 'PATCH',
                headers: getAuthHeaders(),
                body: JSON.stringify(payload)
            });
            document.getElementById('snp-sync-status').textContent = 'Backed up successfully! ✅';
        } catch (err) {
            document.getElementById('snp-sync-status').textContent = 'Upload failed ❌';
        }
    };
    // 3. Download Data (Sync Down)
    const syncFromDrive = async () => {
        document.getElementById('snp-sync-status').textContent = 'Downloading... ⏳';
        const fileId = await getOrCreateDriveFile();
        if (!fileId) {
            document.getElementById('snp-sync-status').textContent = 'Error: Not authenticated ❌';
            return;
        }
        try {
            const res = await fetch(`https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`, {
                headers: getAuthHeaders()
            });
            
            if (res.status === 200) {
                const data = await res.json();
                
                // Merge state safely
                appState = { ...appState, ...(data.appState || {}) };
                profileNotes = { ...profileNotes, ...(data.profileNotes || {}) };
                bookmarkedProfiles = { ...bookmarkedProfiles, ...(data.bookmarkedProfiles || {}) };
                
                saveState();
