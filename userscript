// ==UserScript==
// @name         GreaseSniff
// @namespace    https://sniffies.com/
// @version      2.3.0
// @description  Advanced filtering, CRM, chat badges, and quick phrases for Sniffies.
// @match        https://sniffies.com/*
// @match        https://*.sniffies.com/*
// @run-at       document-start
// @noframes
// @grant        unsafeWindow
// @grant        GM_getValue
// @grant        GM_setValue
// ==/UserScript==

(function () {
    'use strict';

    // =========================================================================
    // 0. PAGE WINDOW + DEBUG
    // =========================================================================
    const pageWin = (typeof unsafeWindow !== 'undefined') ? unsafeWindow : window;
    const DEBUG = false; // ← set true to log intercepted URLs + WebSocket payloads

    const log  = (...a) => console.log('[GreaseSniff]', ...a);
    const warn = (...a) => console.warn('[GreaseSniff]', ...a);

    // =========================================================================
    // 1. STORAGE & STATE  (keys unchanged — settings, notes, bookmarks carry over)
    // =========================================================================
    const KEY_STATE     = 'sniffiesSoftFilterState_v2';
    const KEY_NOTES     = 'sniffiesSoftFilterNotes_v1';
    const KEY_BOOKMARKS = 'sniffiesSoftFilterBookmarks_v1';
    const KEY_HIDDEN    = 'sniffiesHiddenProfiles_v1';
    const KEY_CHATS     = 'sniffiesChatHistory_v1';
    const KEY_TOKEN     = 'snp_drive_token';

    const DEFAULT_STATE = {
        enabled: true,
        // Broad attitude filters — each INCLUDES its subcategories
        hideBottom: true, hideVersBottom: true, hideSide: false,
        hideVers: false, hideVersTop: false, hideTop: false,
        hideUnspecified: false,
        // Subcategory filters — catch ONLY that subcategory
        hideSubBottom: false, hidePowerBottom: false,
        hidePassiveTop: false, hideDomTopBreeder: false,
        // Text Filters
        excludeProfileTerms: '', includeProfileTerms: '',
        excludeProfileTermsEnabled: true, includeProfileTermsEnabled: true,
        // Chat Filters
        hideRecentChats24h: false, hideAnyChats: false, showOnlyChats: false,
        showChatAges: true,
        // Quick Phrases
        introMessages: ['Howdy', 'Hey there', "How's your night going?", "What's up?", 'Want to chat?'].join('\n')
    };

    let appState = { ...DEFAULT_STATE, ...(GM_getValue(KEY_STATE, {}) || {}) };
    const saveState = () => GM_setValue(KEY_STATE, appState);

    let profileNotes       = GM_getValue(KEY_NOTES, {}) || {};
    let bookmarkedProfiles = GM_getValue(KEY_BOOKMARKS, {}) || {};
    let hiddenProfiles     = GM_getValue(KEY_HIDDEN, {}) || {};
    const saveNotes     = () => GM_setValue(KEY_NOTES, profileNotes);
    const saveBookmarks = () => GM_setValue(KEY_BOOKMARKS, bookmarkedProfiles);
    const saveHidden    = () => GM_setValue(KEY_HIDDEN, hiddenProfiles);

    let driveToken = GM_getValue(KEY_TOKEN, null);

    // =========================================================================
    // 2. CACHES
    // =========================================================================
    const profileCache = new Map();                                    // id -> {name, role, description}
    let chatHistory = new Map(Object.entries(GM_getValue(KEY_CHATS, {}) || {})); // id -> lastChatMs
    let chatDirty = false;

    const trimMap = (map, max) => { while (map.size > max) map.delete(map.keys().next().value); };

    // =========================================================================
    // 3. HELPERS
    // =========================================================================
    function normalizeTs(v) {
        if (typeof v === 'number') return v > 1e12 ? v : v * 1000;      // seconds vs ms
        if (typeof v === 'string') { const p = Date.parse(v); if (!Number.isNaN(p)) return p; }
        return Date.now();
    }

    // Profile-ID extraction with fallbacks
    function getMarkerId(el) {
        if (!el) return '';
        let id = el.id
            || el.dataset?.userId
            || el.dataset?.profileId
            || el.getAttribute?.('data-user-id')
            || el.getAttribute?.('data-id')
            || '';
        if (!id) {
            const link = el.querySelector?.('a[href*="/profile/"]');
            if (link) {
                const m = (link.getAttribute('href') || '').match(/\/profile\/([^/?#]+)/);
                if (m) id = m[1];
            }
        }
        return id ? String(id) : '';
    }

    function matchTerms(text, termsString) {
        if (!termsString || !text) return false;
        const terms = String(termsString).split('\n').map(t => t.trim().toLowerCase()).filter(Boolean);
        return terms.some(t => text.includes(t));
    }

