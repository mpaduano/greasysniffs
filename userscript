    function updateLiveStats() {
        const statsEl = document.getElementById('snp-live-stats');
        if (statsEl) statsEl.textContent = 'Profiles captured: ' + profileCache.size +
            ' · Chat history: ' + chatHistory.size + ' people';

        const rolesEl = document.getElementById('snp-roles-seen');
        if (rolesEl) {
            const counts = new Map();
            profileCache.forEach((p) => {
                const r = normalizeRole(p.role) || '(empty)';
                counts.set(r, (counts.get(r) || 0) + 1);
            });
            const lines = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12)
                .map(([r, n]) => '"' + r + '" x' + n);
            rolesEl.textContent = lines.length
                ? 'Roles seen: ' + lines.join(' · ')
                : 'Roles seen: none yet (browse the map to load profiles).';
        }

        // At-a-glance health on the launcher itself (no console needed)
        const launcherEl = document.getElementById('snp-dashboard-launcher');
        if (launcherEl) {
            launcherEl.textContent = '⚙️ GS · P:' + profileCache.size + ' · C:' + chatHistory.size;
            launcherEl.title = 'P = profiles captured · C = chatted-with captured. ' +
                'P should climb while you browse the map; C climbs after you open the Chats page.';
        }
    }

