    function switchTab(target) {
        const d = document.getElementById('gs-dash');
        if (!d) return;
        d.querySelectorAll('.gs-tab').forEach(t => t.classList.toggle('active', t.dataset.target === target));
        d.querySelectorAll('.gs-panel').forEach(p => { p.style.display = p.id === target ? 'block' : 'none'; });
        if (document.getElementById('gs-diag')) updateStats();
    }

    function bindControls() {
        CHECKBOXES.forEach(pair => {
            const el = document.getElementById(pair[0]); if (!el) return;
            el.checked = !!appState[pair[1]];
            el.onchange = (e) => { appState[pair[1]] = e.target.checked; saveState(); scheduleFilter(); };
        });
        TEXTAREAS.forEach(pair => {
            const el = document.getElementById(pair[0]); if (!el) return;
            el.value = appState[pair[1]] == null ? '' : appState[pair[1]];
            el.addEventListener('input', (e) => { appState[pair[1]] = e.target.value; saveState(); });
        });
    }

    function syncControls() {
        CHECKBOXES.forEach(pair => { const el = document.getElementById(pair[0]); if (el) el.checked = !!appState[pair[1]]; });
        TEXTAREAS.forEach(pair => { const el = document.getElementById(pair[0]); if (el) el.value = appState[pair[1]] == null ? '' : appState[pair[1]]; });
    }

    function updateStats() {
        const l = document.getElementById('gs-launcher');
        if (l) {
            const txt = 'GS v3.0 U' + profileCache.size + ' C' + chatHistory.size;
            if (l.textContent !== txt) l.textContent = txt;
        }
        const markers = document.querySelectorAll(MARKER_SEL);
        let resolved = 0;
        try {
            for (let i = 0; i < markers.length; i++) if (resolveId(markers[i])) resolved++;
        } catch (e) { resolved = -1; }
        const s = document.getElementById('gs-stats');
        if (s) {
            s.innerHTML = 'v' + VERSION + ' | markers <b>' + markers.length + '</b> | resolved <b>' + resolved +
                '</b> | users <b>' + profileCache.size + '</b> | chatted <b>' + chatHistory.size + '</b><br>' +
                'payloads fetch:' + stats.fetch + ' xhr:' + stats.xhr + ' ws:' + stats.ws + ' | mutations:' + mutations +
                (resolved <= 0 && markers.length ? '<br><span style="color:#ff7575">No marker ids resolved - see Diagnose.</span>' : '');
        }
        const dg = document.getElementById('gs-diag');
        if (!dg) return;
        try {
            const roles = new Map();
            profileCache.forEach(p => { const r = normalizeRole(p.role) || '(none)'; roles.set(r, (roles.get(r) || 0) + 1); });
            const top = [...roles.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10).map(e => e[0] + ' x' + e[1]).join('\n') || '(none yet)';
            const m0 = markers[0];
            dg.textContent =
                'version   ' + VERSION + '\n' +
                'Transports  fetch=' + stats.fetch + '  xhr=' + stats.xhr + '  ws=' + stats.ws + '\n' +
                'Users parsed=' + stats.users + '   chat events=' + stats.chats + '\n' +
                'markers=' + markers.length + '  resolved=' + resolved + '\n' +
                'Last payload URL: ' + (stats.lastUrl || '(none)') + '\n\n' +
                'Roles seen:\n' + top + '\n\n' +
                'Marker id candidates (first marker):\n' +
                (m0 ? JSON.stringify(candidatesFor(m0)) : '(no markers on screen)') + '\n\n' +
                'First marker HTML:\n' + (m0 ? m0.outerHTML.slice(0, 900) : '(none)');
        } catch (e) {
            dg.textContent = 'diagnostic threw: ' + ((e && e.message) || e) +
                '\nversion ' + VERSION + ' | fetch:' + stats.fetch + ' xhr:' + stats.xhr + ' ws:' + stats.ws;
        }
    }

