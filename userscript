// ==UserScript==
// @name         GreaseySniffs
// @namespace    https://sniffies.com/
// @version      3.0
// @description  Filtering, CRM, chat badges and quick phrases for Sniffies. Transport-agnostic + self-diagnosing.
// @match        https://sniffies.com/*
// @match        https://*.sniffies.com/*
// @run-at       document-start
// @noframes
// @grant        unsafeWindow
// @grant        GM_getValue
// @grant        GM_setValue
// ==/UserScript==

(function () {
    'use strict';

    const VERSION = '3.0.0';
    const pageWin = (typeof unsafeWindow !== 'undefined') ? unsafeWindow : window;
    const DEBUG = false;

    const log = (...a) => console.log('[GreaseySniffs]', ...a);
    const warn = (...a) => console.warn('[GreaseySniffs]', ...a);

    if (pageWin.__GreaseySniffs_ACTIVE__) {
        console.error('[GreaseySniffs] Another copy is already running. Disable older copies and reload.');
        const banner = () => showBanner('Duplicate GreaseySniffs detected - disable older versions, then reload.');
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', banner, { once: true });
        else banner();
        return;
    }
    pageWin.__GreaseySniffs_ACTIVE__ = true;

    const KEY = {
        state: 'sniffiesSoftFilterState_v2',
        notes: 'sniffiesSoftFilterNotes_v1',
        bookmarks: 'sniffiesSoftFilterBookmarks_v1',
        hidden: 'sniffiesHiddenProfiles_v1',
        chats: 'sniffiesChatHistory_v1',
        token: 'snp_drive_token'
    };

    const DEFAULTS = {
        enabled: true,
        hideBottom: true, hideVersBottom: true, hideSide: false,
        hideVers: false, hideVersTop: false, hideTop: false,
        hideUnspecified: false,
        hideSubBottom: false, hidePowerBottom: false,
        hidePassiveTop: false, hideDomTopBreeder: false,
        excludeProfileTerms: '', includeProfileTerms: '',
        excludeProfileTermsEnabled: true, includeProfileTermsEnabled: true,
        hideRecentChats24h: false, hideAnyChats: false, showOnlyChats: false,
        showChatAges: true,
        introMessages: ['Howdy', 'Hey there', "How's your night going?", "What's up?", 'Want to chat?'].join('\n')
    };

    const gmGet = (k, d) => { try { return GM_getValue(k, d); } catch (e) { return d; } };
    const gmSet = (k, v) => { try { GM_setValue(k, v); } catch (e) { warn('storage write failed', e); } };

    let appState = Object.assign({}, DEFAULTS, gmGet(KEY.state, {}) || {});
    let profileNotes = gmGet(KEY.notes, {}) || {};
    let bookmarkedProfiles = gmGet(KEY.bookmarks, {}) || {};
    let hiddenProfiles = gmGet(KEY.hidden, {}) || {};
    let driveToken = gmGet(KEY.token, null);

    const saveState = () => gmSet(KEY.state, appState);
    const saveNotes = () => gmSet(KEY.notes, profileNotes);
    const saveBookmarks = () => gmSet(KEY.bookmarks, bookmarkedProfiles);
    const saveHidden = () => gmSet(KEY.hidden, hiddenProfiles);

    const profileCache = new Map();
    const chatHistory = new Map();
    let chatDirty = false;
    const markerIds = new WeakMap();
    let lastTarget = null;
    const stats = { fetch: 0, xhr: 0, ws: 0, users: 0, chats: 0, lastUrl: '' };

    function trimMap(map, max) { let n = 0; for (const k of map.keys()) { if (++n > max) map.delete(k); } }

    function showBanner(msg) {
        const go = () => {
            if (!document.body || document.getElementById('gs-banner')) return;
            const b = document.createElement('div');
            b.id = 'gs-banner';
            b.style.cssText = 'position:fixed;top:0;left:50%;transform:translateX(-50%);z-index:2147483647;' +
                'background:#c0392b;color:#fff;padding:10px 16px;border-radius:0 0 8px 8px;' +
                'font:12px system-ui,sans-serif;max-width:80vw;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.5)';
            b.textContent = msg;
            b.onclick = () => b.remove();
            document.body.appendChild(b);
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go, { once: true });
        else go();
    }

    const isEl = (n) => !!n && n.nodeType === 1;

    function parseTs(v) {
        if (typeof v === 'number' && isFinite(v)) return v > 1e12 ? v : v * 1000;
        if (typeof v === 'string' && v) {
            if (/^\d{10,13}$/.test(v)) { const n = Number(v); return n > 1e12 ? n : n * 1000; }
            const p = Date.parse(v);
            if (!Number.isNaN(p)) return p;
        }
        return null;
    }

    function matchTerms(text, termsString) {
        if (!termsString || !text) return false;
        const hay = String(text).toLowerCase();
        return String(termsString).split(/\r?\n/).map(t => t.trim().toLowerCase()).filter(Boolean)
            .some(t => hay.includes(t));
    }

    function normalizeRole(raw) {
        if (raw == null) return '';
        let s;
        if (Array.isArray(raw)) s = raw.filter(v => typeof v === 'string').join(' ');
        else if (typeof raw === 'object') s = Object.values(raw).filter(v => typeof v === 'string').join(' ');
        else s = String(raw);
        return s.replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/[_\-.]+/g, ' ')
            .replace(/[(){}\[\],/]/g, ' ').toLowerCase().replace(/\s+/g, ' ').trim();
    }

    function classifyRole(rawRole) {
        const role = normalizeRole(rawRole);
        const t = new Set(role.split(' ').filter(Boolean));
        return {
            role,
            numeric: /^\d+$/.test(role),
            isVers: t.has('vers') || t.has('versatile'),
            isBottom: t.has('bottom'),
            isTop: t.has('top'),
            isSide: t.has('side'),
            isSub: t.has('sub') || t.has('submissive'),
            isDom: t.has('dom') || t.has('domme') || t.has('dominant'),
            isPower: t.has('power'),
            isPassive: t.has('passive'),
            isBreeder: t.has('breeder')
        };
    }

    const ID_KEYS = ['userId', 'user_id', 'profileId', 'profile_id', 'uid', 'id', '_id'];
    const NAME_KEYS = ['name', 'userName', 'username', 'displayName', 'display_name', 'nickname', 'nick', 'handle'];
    const ROLE_KEYS = ['attitude', 'attitudes', 'role', 'roles', 'position', 'attitudeName', 'userAttitude', 'sexualAttitude'];
    const DESC_KEYS = ['description', 'about', 'bio', 'aboutMe', 'about_me', 'tagline', 'interests', 'bioText'];
    const BODY_KEYS = ['message', 'body', 'text', 'content', 'msg', 'messageText'];
    const TS_KEYS = ['createdAt', 'created_at', 'timestamp', 'sentAt', 'sent_at', 'time', 'date', 'updatedAt'];

    const looksLikeId = (v) => typeof v === 'string' && v.length >= 3 && v.length <= 64 && /^[A-Za-z0-9_.:@-]+$/.test(v);

    function pick(obj, keys) {
        for (const k of keys) { const v = obj[k]; if (v != null && typeof v !== 'object') return v; }
        return undefined;
    }

    function cacheUser(rec) {
        const id = String(rec.id);
        const prev = profileCache.get(id) || {};
        profileCache.set(id, {
            name: rec.name != null ? String(rec.name) : (prev.name || ''),
            role: rec.role != null ? rec.role : (prev.role || ''),
            roleKnown: rec.roleKnown || !!prev.roleKnown,
            desc: rec.desc != null ? String(rec.desc) : (prev.desc || '')
        });
        stats.users++;
    }

    function isMessageish(o) {
        return BODY_KEYS.some(k => typeof o[k] === 'string' && o[k].length) &&
            ID_KEYS.some(k => o[k] != null && typeof o[k] !== 'object');
    }

    function walk(node, depth, budget) {
        if (!node || typeof node !== 'object' || depth > 10) return;
        if (budget.n-- <= 0) return;
        if (Array.isArray(node)) { for (const n of node) walk(n, depth + 1, budget); return; }

        const senderId = node.senderId ?? node.sender_id ??
            (node.sender && typeof node.sender === 'object' ? node.sender.id : node.sender);

        if (senderId != null && looksLikeId(String(senderId)) && isMessageish(node)) {
            let t = null;
            for (const k of TS_KEYS) { t = parseTs(node[k]); if (t) break; }
            if (t) {
                const id = String(senderId);
                if (t > (chatHistory.get(id) || 0)) { chatHistory.set(id, t); chatDirty = true; stats.chats++; }
            }
        }

        if (!isMessageish(node)) {
            const idRaw = pick(node, ID_KEYS);
            const name = pick(node, NAME_KEYS);
            let role, roleKnown = false;
            for (const k of ROLE_KEYS) {
                if (node[k] != null && typeof node[k] !== 'object') { role = node[k]; roleKnown = true; break; }
            }
            const desc = pick(node, DESC_KEYS);
            if (idRaw != null && looksLikeId(String(idRaw)) &&
                (name !== undefined || roleKnown || (typeof desc === 'string' && desc))) {
                cacheUser({ id: idRaw, name, role, roleKnown, desc });
            }
        }

        for (const k in node) { const v = node[k]; if (v && typeof v === 'object') walk(v, depth + 1, budget); }
    }

    function ingest(text, url, source) {
        if (typeof text !== 'string' || !text || text.length > 4e6) return;
        const c = text.charCodeAt(0);
        if (c !== 123 && c !== 91) return;
        let data;
        try { data = JSON.parse(text); } catch (e) { return; }
        stats[source] = (stats[source] || 0) + 1;
        stats.lastUrl = url || '';
        const before = chatHistory.size;
        walk(data, 0, { n: 30000 });
        if (chatHistory.size !== before) scheduleFilter();
        if (DEBUG) log(source, url, 'users:', profileCache.size, 'chats:', chatHistory.size);
    }

    function readBody(xhr, url) {
        try {
            if (xhr.responseType && xhr.responseType !== 'text') return;
            if (xhr.responseText) ingest(xhr.responseText, url, 'xhr');
        } catch (e) { }
    }

    function installTransports() {
        try {
            const orig = pageWin.fetch;
            if (typeof orig === 'function' && !orig.__gs) {
                const hooked = function (input) {
                    const p = orig.apply(this, arguments);
                    try {
                        const url = (typeof input === 'string') ? input : (input && input.url) || '';
                        p.then((res) => { try { res.clone().text().then(t => ingest(t, url, 'fetch')); } catch (e) { } })
                            .catch(() => { });
                    } catch (e) { }
                    return p;
                };
                hooked.__gs = true;
                pageWin.fetch = hooked;
            }
        } catch (e) { console.error('[GreaseySniffs] fetch hook failed', e); }

        try {
            const proto = pageWin.XMLHttpRequest && pageWin.XMLHttpRequest.prototype;
            if (proto && !proto.open.__gs) {
                const open = proto.open;
                const pOpen = function (method, url) { try { this.__gsUrl = String(url); } catch (e) { } return open.apply(this, arguments); };
                pOpen.__gs = true;
                proto.open = pOpen;
                const send = proto.send;
                const pSend = function () {
                    try { this.addEventListener('load', () => readBody(this, this.__gsUrl), { once: true }); } catch (e) { }
                    return send.apply(this, arguments);
                };
                pSend.__gs = true;
                proto.send = pSend;
            }
        } catch (e) { console.error('[GreaseySniffs] XHR hook failed', e); }

        try {
            const Native = pageWin.WebSocket;
            if (typeof Native === 'function' && !Native.__gs) {
                function Patched(url, protocols) {
                    const ws = (protocols === undefined) ? new Native(url) : new Native(url, protocols);
                    try { ws.__gsUrl = String(url); } catch (e) { }
                    ws.addEventListener('message', (ev) => { if (typeof ev.data === 'string') ingest(ev.data, ws.__gsUrl, 'ws'); });
                    return ws;
                }
                Patched.prototype = Native.prototype;
                ['CONNECTING', 'OPEN', 'CLOSING', 'CLOSED'].forEach(k => { try { Patched[k] = Native[k]; } catch (e) { } });
                Patched.__gs = true;
                pageWin.WebSocket = Patched;
            }
        } catch (e) { console.error('[GreaseySniffs] WebSocket hook failed', e); }

        log('transports installed (fetch/XHR/WebSocket).');
    }

    const MARKER_SEL = [
        '[data-testid="markerUserContainer"]',
        '.maplibregl-marker',
        '.chat-list-item',
        '[class*="marker"]',
        '[class*="chat-item"]'
    ].join(',');

    const ID_ATTR = /^(data-.*(user|profile|owner|member|account).*(id|uid)|data-userid|data-uid|data-id|data-key)$/i;
    const UUIDISH = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;

    function candidatesFor(el) {
        const out = [];
        const push = (v) => { if (v != null && looksLikeId(String(v)) && out.indexOf(String(v)) === -1) out.push(String(v)); };
        try {
            for (const a of el.attributes) {
                if (ID_ATTR.test(a.name)) push(a.value);
                else if (/^data-/.test(a.name) && /(user|profile|owner|member|uid)/i.test(a.name)) push(a.value);
            }
            if (el.id && !/^maplibre|^marker-\d|^:r/i.test(el.id)) push(el.id);
            const link = el.querySelector('a[href*="/profile/"]');
            if (link) { const m = (link.getAttribute('href') || '').match(/\/profile\/([^/?#]+)/); if (m) push(m[1]); }
            const img = el.querySelector('img[src]');
            if (img) {
                const src = img.getAttribute('src') || '';
                const u = src.match(/[?&](?:userId|user_id|profileId|profile_id|id)=([^&#]+)/i);
                if (u) push(decodeURIComponent(u[1]));
                const g = src.match(UUIDISH); if (g) push(g[0]);
                src.split('/').forEach(seg => { if (/^[A-Za-z0-9_-]{16,64}$/.test(seg)) push(seg); });
            }
        } catch (e) { }
        return out;
    }

    function resolveId(el) {
        if (!isEl(el)) return '';
        let rec = markerIds.get(el);
        if (!rec) { rec = { id: '', candidates: candidatesFor(el) }; markerIds.set(el, rec); }
        if (rec.candidates.length === 1) return rec.candidates[0];
        if (rec.candidates.length > 1) {
            if (profileCache.size) {
                const hit = rec.candidates.find(c => profileCache.has(c));
                if (hit) { rec.id = hit; return hit; }
            }
            if (!rec.id) rec.id = rec.candidates[0];
            return rec.id;
        }
        return '';
    }

    function markerName(id) {
        const p = profileCache.get(id);
        return p && p.name ? p.name : ('#' + String(id).slice(0, 6));
    }

    let filterQueued = false, applying = false, mutations = 0;

    function scheduleFilter() {
        if (filterQueued) return;
        filterQueued = true;
        requestAnimationFrame(() => { filterQueued = false; applyFilters(); });
    }

    function applyFilters() {
        if (!document.body) return;
        applying = true;
        try {
            const markers = document.querySelectorAll(MARKER_SEL);
            const now = Date.now(), day = 86400000;
            for (let i = 0; i < markers.length; i++) filterOne(markers[i], now, day);
        } finally { applying = false; }
    }

    function filterOne(marker, now, day) {
        const id = resolveId(marker);
        if (!id) return;
        if (!appState.enabled) { marker.classList.remove('gs-hide', 'gs-ring'); removeBadge(marker); return; }

        let hide = !!hiddenProfiles[id], ring = false;

        const p = profileCache.get(id);
        if (!hide && p) {
            const c = classifyRole(p.role);
            const known = p.roleKnown && !c.numeric;
            if (known) {
                if (appState.hideSubBottom && c.isBottom && c.isSub) hide = true;
                if (appState.hidePowerBottom && c.isBottom && c.isPower) hide = true;
                if (appState.hidePassiveTop && c.isTop && c.isPassive) hide = true;
                if (appState.hideDomTopBreeder && c.isTop && c.isDom && c.isBreeder) hide = true;

                if (!hide && appState.hideBottom && c.isBottom && !c.isVers) hide = true;
                if (!hide && appState.hideVersBottom && c.isVers && c.isBottom) hide = true;
                if (!hide && appState.hideSide && c.isSide) hide = true;
                if (!hide && appState.hideTop && c.isTop && !c.isVers) hide = true;
                if (!hide && appState.hideVersTop && c.isVers && c.isTop) hide = true;
                if (!hide && appState.hideVers && c.isVers && !c.isBottom && !c.isTop) hide = true;
                if (!hide && appState.hideUnspecified && !c.isBottom && !c.isTop && !c.isVers && !c.isSide) hide = true;
            }
            const hay = ((p.name || '') + ' ' + (p.desc || '')).toLowerCase();
            if (!hide && appState.excludeProfileTermsEnabled && matchTerms(hay, appState.excludeProfileTerms)) hide = true;
            if (!hide && appState.includeProfileTermsEnabled && matchTerms(hay, appState.includeProfileTerms)) ring = true;
        }

        const last = chatHistory.get(id);
        if (!hide && last) {
            if (appState.hideAnyChats) hide = true;
            else if (appState.hideRecentChats24h && (now - last) < day) hide = true;
        }
        if (!hide && appState.showOnlyChats && chatHistory.size && !last) hide = true;

        if (hide) { marker.classList.add('gs-hide'); marker.classList.remove('gs-ring'); removeBadge(marker); return; }

        marker.classList.remove('gs-hide');
        marker.classList.toggle('gs-ring', ring);
        updateBadge(marker, last, now);
    }

    function removeBadge(marker) { const b = marker.querySelector(':scope > .gs-badge'); if (b) b.remove(); }

    function updateBadge(marker, last, now) {
        let b = marker.querySelector(':scope > .gs-badge');
        if (!appState.showChatAges || !last) { if (b) b.remove(); return; }
        if (!b) { b = document.createElement('div'); b.className = 'gs-badge'; marker.appendChild(b); }
        const h = Math.floor((now - last) / 3600000);
        const txt = h < 1 ? '<1h' : h < 48 ? h + 'h' : Math.floor(h / 24) + 'd';
        if (b.textContent !== txt) b.textContent = txt;
    }

    let ctxMenu = null, phraseMenu = null;
    const closeCtx = () => { if (ctxMenu) { ctxMenu.remove(); ctxMenu = null; } };
    const closePhrase = () => { if (phraseMenu) { phraseMenu.remove(); phraseMenu = null; } };

    function place(el, x, y) {
        el.style.left = Math.max(8, Math.min(x, window.innerWidth - el.offsetWidth - 10)) + 'px';
        el.style.top = Math.max(8, Math.min(y, window.innerHeight - el.offsetHeight - 10)) + 'px';
    }

    function showCtx(x, y, id) {
        closeCtx();
        const m = document.createElement('div');
        m.className = 'gs-menu';
        const who = document.createElement('div');
        who.className = 'gs-menu-title';
        who.textContent = markerName(id);
        m.appendChild(who);
        const b1 = document.createElement('button');
        b1.className = 'gs-btn'; b1.textContent = 'Quick Phrase';
        b1.onclick = () => { closeCtx(); showPhrase(x, y); };
        m.appendChild(b1);
        const b2 = document.createElement('button');
        b2.className = 'gs-btn'; b2.textContent = 'Bookmark / Note';
        b2.onclick = () => { closeCtx(); openCRM(id); };
        m.appendChild(b2);
        const isHidden = !!hiddenProfiles[id];
        const b3 = document.createElement('button');
        b3.className = 'gs-btn danger';
        b3.textContent = isHidden ? 'Unhide Profile' : 'Hide Profile';
        b3.onclick = () => {
            if (isHidden) delete hiddenProfiles[id]; else hiddenProfiles[id] = { added: Date.now() };
            saveHidden(); closeCtx(); scheduleFilter(); renderCRM();
        };
        m.appendChild(b3);
        document.body.appendChild(m);
        place(m, x, y);
        ctxMenu = m;
    }

    function showPhrase(x, y) {
        closePhrase();
        const m = document.createElement('div');
        m.className = 'gs-menu';
        const t = document.createElement('div');
        t.className = 'gs-menu-title';
        t.textContent = 'Quick Phrases' + (lastTarget ? ' to ' + markerName(lastTarget.id) : '');
        m.appendChild(t);
        const list = String(appState.introMessages || '').split(/\r?\n/).map(s => s.trim()).filter(Boolean);
        if (!list.length) {
            const e = document.createElement('div');
            e.className = 'gs-menu-title'; e.textContent = 'None set - add them in the dashboard.';
            m.appendChild(e);
        }
        list.forEach(p => {
            const b = document.createElement('button');
            b.className = 'gs-btn'; b.textContent = p;
            b.onclick = () => { closePhrase(); sendPhrase(p); };
            m.appendChild(b);
        });
        document.body.appendChild(m);
        place(m, x, y);
        phraseMenu = m;
    }

    function findComposer() {
        const sels = ['textarea[placeholder*="message" i]', 'input[placeholder*="message" i]',
            'textarea[placeholder*="say" i]', '[contenteditable="true"][role="textbox"]',
            '.chat-input textarea', 'form textarea', 'textarea'];
        for (const s of sels) { const el = document.querySelector(s); if (el && el.offsetParent !== null) return el; }
        return null;
    }

    function setNativeValue(el, text) {
        if (el.isContentEditable) {
            el.textContent = text;
            el.dispatchEvent(new InputEvent('input', { bubbles: true }));
            return;
        }
        const proto = el.tagName === 'TEXTAREA' ? pageWin.HTMLTextAreaElement.prototype : pageWin.HTMLInputElement.prototype;
        const d = Object.getOwnPropertyDescriptor(proto, 'value');
        const setter = d && d.set;
        if (setter) setter.call(el, text); else el.value = text;
        el.dispatchEvent(new Event('input', { bubbles: true }));
    }

    function sendPhrase(text) {
        const input = findComposer();
        if (!input) { warn('Chat input not found - open the conversation first.'); showBanner('Open a conversation first.'); return; }
        setNativeValue(input, text);
        try { input.focus(); } catch (e) { }
        setTimeout(() => {
            const btn = document.querySelector('button[aria-label*="send" i], button[title*="send" i], form button[type="submit"]');
            if (btn && !btn.disabled) { btn.click(); return; }
            ['keydown', 'keypress', 'keyup'].forEach(type => {
                input.dispatchEvent(new KeyboardEvent(type, { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true }));
            });
        }, 300);
    }

    document.addEventListener('contextmenu', (e) => {
        try {
            if (!isEl(e.target)) return;
            const m = e.target.closest(MARKER_SEL);
            if (!m) return;
            const id = resolveId(m);
            if (!id) { warn('Right-clicked a marker with no resolvable id.'); return; }
            e.preventDefault();
            showCtx(e.clientX, e.clientY, id);
        } catch (err) { console.error('[GreaseySniffs] contextmenu', err); }
    }, true);

    document.addEventListener('click', (e) => {
        const t = isEl(e.target) ? e.target : null;
        if (ctxMenu && (!t || !ctxMenu.contains(t))) closeCtx();
        if (phraseMenu && (!t || !phraseMenu.contains(t))) closePhrase();
        if (t && t.closest) {
            const m = t.closest(MARKER_SEL);
            if (m) { const id = resolveId(m); if (id) lastTarget = { id, t: Date.now() }; }
        }
    }, true);

    ['scroll', 'wheel', 'resize', 'blur'].forEach(ev =>
        window.addEventListener(ev, () => { closeCtx(); closePhrase(); }, { passive: true }));

    const CHECKBOXES = [
        ['gs-enabled', 'enabled'],
        ['gs-hideBottom', 'hideBottom'], ['gs-hideVersBottom', 'hideVersBottom'],
        ['gs-hideSide', 'hideSide'], ['gs-hideVers', 'hideVers'],
        ['gs-hideVersTop', 'hideVersTop'], ['gs-hideTop', 'hideTop'],
        ['gs-hideUnspecified', 'hideUnspecified'],
        ['gs-hideSubBottom', 'hideSubBottom'], ['gs-hidePowerBottom', 'hidePowerBottom'],
        ['gs-hidePassiveTop', 'hidePassiveTop'], ['gs-hideDomTopBreeder', 'hideDomTopBreeder'],
        ['gs-showChatAges', 'showChatAges'],
        ['gs-hideRecentChats24h', 'hideRecentChats24h'], ['gs-hideAnyChats', 'hideAnyChats'],
        ['gs-showOnlyChats', 'showOnlyChats'],
        ['gs-exEnabled', 'excludeProfileTermsEnabled'], ['gs-inEnabled', 'includeProfileTermsEnabled']
    ];
