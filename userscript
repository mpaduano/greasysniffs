    const CLIENT_ID = 'YOUR_CLIENT_ID.apps.googleusercontent.com';
    const FILE = 'GreaseySniffs_backup.json';
    const authHeaders = () => ({ Authorization: 'Bearer ' + driveToken, 'Content-Type': 'application/json' });
    const loginUrl = () => 'https://accounts.google.com/o/oauth2/v2/auth?client_id=' + CLIENT_ID +
        '&redirect_uri=' + encodeURIComponent('https://sniffies.com/') +
        '&response_type=token&scope=' + encodeURIComponent('https://www.googleapis.com/auth/drive.appdata');
    const syncStatus = (t) => { const el = document.getElementById('gs-syncstat'); if (el) el.textContent = t; };

    async function driveFileId() {
        const r = await fetch('https://www.googleapis.com/drive/v3/files?spaces=appDataFolder&q=name%3D%27' + FILE + '%27', { headers: authHeaders() });
        const j = await r.json();
        if (j.files && j.files.length) return j.files[0].id;
        const c = await fetch('https://www.googleapis.com/drive/v3/files', {
            method: 'POST', headers: authHeaders(), body: JSON.stringify({ name: FILE, parents: ['appDataFolder'] })
        });
        const cj = await c.json();
        return cj.id;
    }

    async function backup() {
        if (!driveToken) { syncStatus('Paste a token first'); return; }
        syncStatus('Backing up...');
        try {
            const id = await driveFileId();
            if (!id) { syncStatus('Could not open file'); return; }
            const r = await fetch('https://www.googleapis.com/upload/drive/v3/files/' + id + '?uploadType=media', {
                method: 'PATCH', headers: authHeaders(),
                body: JSON.stringify({
                    v: VERSION, appState, profileNotes, bookmarkedProfiles, hiddenProfiles,
                    chatHistory: Object.fromEntries(chatHistory), savedAt: Date.now()
                })
            });
            syncStatus(r.ok ? 'Backed up' : 'Upload failed (' + r.status + ')');
        } catch (e) { syncStatus('Upload failed'); }
    }

    async function restore() {
        if (!driveToken) { syncStatus('Paste a token first'); return; }
        syncStatus('Restoring...');
        try {
            const id = await driveFileId();
            if (!id) { syncStatus('Could not open file'); return; }
            const r = await fetch('https://www.googleapis.com/drive/v3/files/' + id + '?alt=media', { headers: authHeaders() });
            if (!r.ok) { syncStatus('Restore failed (' + r.status + ')'); return; }
            const d = await r.json();
            appState = Object.assign(appState, d.appState || {});
            profileNotes = Object.assign(profileNotes, d.profileNotes || {});
            bookmarkedProfiles = Object.assign(bookmarkedProfiles, d.bookmarkedProfiles || {});
            hiddenProfiles = Object.assign(hiddenProfiles, d.hiddenProfiles || {});
            Object.entries(d.chatHistory || {}).forEach(e => {
                const t = Number(e[1]) || 0;
                if (t > (chatHistory.get(e[0]) || 0)) chatHistory.set(e[0], t);
            });
            saveState(); saveNotes(); saveBookmarks(); saveHidden();
            syncControls(); renderCRM(); scheduleFilter();
            syncStatus('Restored');
        } catch (e) { syncStatus('Download failed'); }
    }

    function bindSync() {
        const ti = document.getElementById('gs-token');
        if (ti) {
            ti.value = driveToken || '';
            ti.onchange = (e) => { driveToken = e.target.value.trim(); gmSet(KEY.token, driveToken); syncStatus('Token saved.'); };
        }
        const auth = document.getElementById('gs-auth');
        if (auth) auth.onclick = () => window.open(loginUrl(), '_blank', 'width=520,height=640');
        const up = document.getElementById('gs-up');
        if (up) up.onclick = backup;
        const down = document.getElementById('gs-down');
        if (down) down.onclick = restore;
        if (CLIENT_ID.startsWith('YOUR_')) syncStatus('Set CLIENT_ID at the bottom of the script to enable OAuth.');
    }

    const initErrors = [];
    function safe(fn, label) {
        try { fn(); } catch (e) {
            initErrors.push(label + ': ' + ((e && e.message) || e));
            console.error('[GreaseySniffs] init step failed -', label, e);
        }
    }

    function startObserver() {
        const mo = new MutationObserver(recs => {
            if (applying) return;
            mutations += recs.length;
            scheduleFilter();
        });
        mo.observe(document.body, { childList: true, subtree: true });
    }

    function persistChats() {
        if (chatDirty) { chatDirty = false; gmSet(KEY.chats, Object.fromEntries(chatHistory)); }
    }

    function init() {
        safe(injectStyles, 'styles');
        safe(injectUI, 'ui');
        safe(startObserver, 'observer');
        safe(() => setInterval(() => {
            try { scheduleFilter(); updateStats(); } catch (e) { console.error(e); }
        }, 2000), 'tick');
        safe(() => setInterval(() => {
            try { trimMap(profileCache, 8000); trimMap(chatHistory, 8000); persistChats(); } catch (e) { console.error(e); }
        }, 30000), 'persist');
        window.addEventListener('pagehide', persistChats);
        if (initErrors.length) showBanner('GreaseySniffs init problems: ' + initErrors.join(' | '));
        log('v' + VERSION + ' ready');
    }

    installTransports();

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
    else init();

    if (window.location.hash.indexOf('access_token=') !== -1) {
        try {
            const params = new URLSearchParams(window.location.hash.substring(1));
            const tok = params.get('access_token');
            if (tok) {
                driveToken = tok;
                gmSet(KEY.token, tok);
                history.replaceState(null, '', window.location.pathname + window.location.search);
            }
        } catch (e) { console.error('[GreaseySniffs] token capture failed', e); }
    }

    pageWin.__GreaseySniffs__ = {
        version: VERSION,
        profiles: profileCache,
        chats: chatHistory,
        stats: stats,
        state: () => appState,
        scan: () => {
            const ms = document.querySelectorAll(MARKER_SEL);
            return {
                markers: ms.length,
                resolved: Array.prototype.filter.call(ms, m => !!resolveId(m)).length,
                sample: ms[0] ? ms[0].outerHTML.slice(0, 700) : null,
                candidates: ms[0] ? candidatesFor(ms[0]) : []
            };
        }
    };
