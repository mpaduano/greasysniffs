    function bindControls() {
        CHECKBOXES.forEach(([id, key]) => {
            const el = document.getElementById(id);
            if (!el) return;
            el.checked = !!appState[key];
            el.onchange = (e) => { appState[key] = e.target.checked; saveState(); scheduleFilter(); };
        });
        TEXTAREAS.forEach(([id, key]) => {
            const el = document.getElementById(id);
            if (!el) return;
            el.value = appState[key] ?? '';
            el.addEventListener('input', (e) => { appState[key] = e.target.value; saveState(); });
        });
