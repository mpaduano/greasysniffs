        dashboard.querySelectorAll('.snp-tab').forEach(tab => {
            tab.onclick = () => switchTab(tab.dataset.target);
        });

        bindControls();
        renderCRMList();
        addSyncTab(); // built as part of injection — no race, no duplicates
    };

    const observeFilterChanges = () => {
        // childList only: our own class toggles don't retrigger us. Badge
        // add/remove triggers one extra converging pass, which is harmless.
        new MutationObserver(scheduleFilter).observe(document.body, { childList: true, subtree: true });
    };

    const maintainUI = () => {
        if (document.getElementById('snp-dashboard-launcher') && document.getElementById('snp-main-dashboard')) return;
        injectDashboardUI();
    };

    // =========================================================================
    // 10. GOOGLE DRIVE SYNC ENGINE
    // =========================================================================

    const GOOGLE_CLIENT_ID = 'YOUR_CLIENT_ID.apps.googleusercontent.com'; // <-- put your real client ID here
    const FILE_NAME = 'sniffies_soft_filter_backup.json';

    let driveAccessToken = GM_getValue(TOKEN_KEY, null);

    const getAuthHeaders = () => ({
        'Authorization': `Bearer ${driveAccessToken}`,
        'Content-Type': 'application/json'
    });

    const getLoginUrl = () => {
        const redirectUri = 'https://sniffies.com'; // must be registered on your Google OAuth client
        const scope = 'https://www.googleapis.com/auth/drive.appdata';
        return `https://accounts.google.com/o/oauth2/v2/auth?client_id=${GOOGLE_CLIENT_ID}&redirect_uri=${encodeURIComponent(redirectUri)}&response_type=token&scope=${encodeURIComponent(scope)}`;
    };

    const setSyncStatus = (text) => {
        const el = document.getElementById('snp-sync-status');
        if (el) el.textContent = text;
    };

    const getOrCreateDriveFile = async () => {
        if (!driveAccessToken) return null;
        try {
            const searchRes = await fetch(`https://www.googleapis.com/drive/v3/files?spaces=appDataFolder&q=name='${FILE_NAME}'`, { headers: getAuthHeaders() });
            const searchData = await searchRes.json();
            if (searchData.files && searchData.files.length > 0) return searchData.files[0].id;

            const createRes = await fetch('https://www.googleapis.com/drive/v3/files', {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({ name: FILE_NAME, parents: ['appDataFolder'] })
            });
            const createData = await createRes.json();
            return createData.id;
        } catch (err) {
            console.error('[GreaseSniff] Drive API error:', err);
            return null;
        }
    };

    const syncToDrive = async () => {
        if (!driveAccessToken) { setSyncStatus('Paste a token first ❌'); return; }
        setSyncStatus('Syncing up... ⏳');
        const fileId = await getOrCreateDriveFile();
        if (!fileId) { setSyncStatus('Error: Not authenticated ❌'); return; }
        const payload = {
            appState, profileNotes, bookmarkedProfiles, hiddenProfiles,
            chatHistory: Object.fromEntries(chatHistoryCache),
            timestamp: Date.now()
        };
        try {
            const res = await fetch(`https://www.googleapis.com/upload/drive/v3/files/${fileId}?uploadType=media`, {
                method: 'PATCH',
                headers: getAuthHeaders(),
                body: JSON.stringify(payload)
            });
            setSyncStatus(res.ok ? 'Backed up successfully! ✅' : `Upload failed (${res.status}) ❌`);
        } catch (err) {
            setSyncStatus('Upload failed ❌');
        }
    };

    const syncFromDrive = async () => {
        if (!driveAccessToken) { setSyncStatus('Paste a token first ❌'); return; }
        setSyncStatus('Downloading... ⏳');
        const fileId = await getOrCreateDriveFile();
        if (!fileId) { setSyncStatus('Error: Not authenticated ❌'); return; }
        try {
            const res = await fetch(`https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`, { headers: getAuthHeaders() });
            if (res.status === 200) {
                const data = await res.json();
                appState = { ...appState, ...(data.appState || {}) };
                profileNotes = { ...profileNotes, ...(data.profileNotes || {}) };
                bookmarkedProfiles = { ...bookmarkedProfiles, ...(data.bookmarkedProfiles || {}) };
                hiddenProfiles = { ...hiddenProfiles, ...(data.hiddenProfiles || {}) };
                if (data.chatHistory) {
                    Object.entries(data.chatHistory).forEach(([id, t]) => {
                        const prev = chatHistoryCache.get(id) || 0;
                        if (t > prev) chatHistoryCache.set(id, t);
                    });
                    chatCacheDirty = true;
                }
                saveState(); saveNotes(); saveBookmarks(); saveHiddenProfiles();

                // Re-bind EVERY control + re-render (previously only the master toggle refreshed)
                syncControlsFromState();
                renderCRMList();
                scheduleFilter();
                setSyncStatus('Restored successfully! ✅');
            } else if (res.status === 401) {
                setSyncStatus('Token expired — get a new one ❌');
            } else {
                setSyncStatus(`Restore failed (${res.status}) ❌`);
            }
        } catch (err) {
            setSyncStatus('Download failed ❌');
        }
    };

    const addSyncTab = () => {
        const dash = document.getElementById('snp-main-dashboard');
        if (!dash || document.getElementById('snp-tab-sync')) return;

        const tabContainer = document.getElementById('snp-tab-bar');
        const syncTabBtn = document.createElement('button');
        syncTabBtn.className = 'snp-tab';
        syncTabBtn.dataset.target = 'snp-tab-sync';
        syncTabBtn.textContent = 'Sync';
        syncTabBtn.onclick = () => switchTab('snp-tab-sync');
        tabContainer.appendChild(syncTabBtn);

        const contentContainer = document.getElementById('snp-tab-content-wrap');
        const syncContent = document.createElement('div');
        syncContent.id = 'snp-tab-sync';
        syncContent.className = 'snp-tab-content';
        syncContent.style.display = 'none';

        syncContent.innerHTML = `
            <strong>Google Drive Backup</strong>
            <p style="font-size:11px; color:#8ea0ba; margin: 4px 0 12px;">Sync your settings, filters, bookmarks, and chat history across devices via a hidden app folder in your Google Drive.</p>
            <div style="display:flex; flex-direction:column; gap:10px;">
                <input type="password" id="snp-drive-token-input" placeholder="Paste OAuth Token here..." style="background:rgba(0,0,0,0.3); color:#fff; border:1px solid rgba(255,255,255,0.2); padding:6px; border-radius:4px; font-size:11px;">
                <button id="snp-auth-btn" style="background:#4285F4; color:#fff; border:none; padding:8px; border-radius:4px; cursor:pointer; font-weight:bold;">1. Get Auth Token</button>
                <div style="display:flex; gap:8px;">
                    <button id="snp-sync-up" style="flex:1; background:#0f9d58; color:#fff; border:none; padding:8px; border-radius:4px; cursor:pointer; font-weight:bold;">↑ Backup to Drive</button>
                    <button id="snp-sync-down" style="flex:1; background:#db4437; color:#fff; border:none; padding:8px; border-radius:4px; cursor:pointer; font-weight:bold;">↓ Restore Data</button>
                </div>
                <div id="snp-sync-status" style="text-align:center; margin-top:8px; font-size:11px; color:#ffd250; min-height:16px;"></div>
            </div>
        `;
        contentContainer.appendChild(syncContent);

        const tokenInput = document.getElementById('snp-drive-token-input');
        tokenInput.value = driveAccessToken || '';

        document.getElementById('snp-auth-btn').onclick = () => {
            window.open(getLoginUrl(), '_blank', 'width=500,height=600');
            setSyncStatus('Copy the token from the URL bar after logging in, and paste it above.');
        };
        tokenInput.onchange = (e) => {
            driveAccessToken = e.target.value.trim();
            GM_setValue(TOKEN_KEY, driveAccessToken);
            setSyncStatus('Token saved.');
        };
        document.getElementById('snp-sync-up').onclick = syncToDrive;
        document.getElementById('snp-sync-down').onclick = syncFromDrive;
    };

    // =========================================================================
    // 11. INITIALIZATION & BOOTSTRAP
    // =========================================================================

    const init = () => {
        injectStyles();
        injectDashboardUI();
        observeProfileModals();   // body exists now — safe
        observeFilterChanges();

        // Fallback tick: re-applies filters + maintains UI even with no mutations
        setInterval(() => {
            applyFilters();
            maintainUI();
        }, 2000);

        // Periodic chat-history persistence + cache trimming
        setInterval(() => {
            trimMap(profileCache, 5000);
            trimMap(chatHistoryCache, 5000);
            if (chatCacheDirty) {
                chatCacheDirty = false;
                GM_setValue(CHAT_KEY, Object.fromEntries(chatHistoryCache));
            }
        }, 30000);

        console.log('[GreaseSniff] V2.1 loaded.');
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
        init();
    }

    // OAuth token capture — runs at the very end of top-level evaluation so all
    // bindings above are initialized (no TDZ issues).
    if (window.location.hash.includes('access_token=')) {
        try {
            const params = new URLSearchParams(window.location.hash.substring(1));
            const token = params.get('access_token');
            if (token) {
                driveAccessToken = token;
                GM_setValue(TOKEN_KEY, token);
                window.location.hash = '';
                alert('GreaseSniff: Google Drive token captured! You can close this tab if it popped up.');
            }
        } catch (e) {
            console.error('[GreaseSniff] token capture failed:', e);
        }
    }

})();
